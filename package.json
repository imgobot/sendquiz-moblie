{
  "name": "@send/mobile",
  "version": "1.0.0",
  "engines": {
    "node": "24.14.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "dev:install-ca": "bash scripts/install-dev-ca.sh",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "eb:deploy:ios": "APP_ENV=production USE_CCACHE=0 IOS_GOOGLE_SERVICES_FILE=\"$PWD/GoogleService-Info.plist\" EAS_LOCAL_BUILD_ARTIFACTS_DIR=\"$HOME/Desktop/APP_BUILD_ASSET/send\" eas build -p ios --profile production-ios --local",
    "eb:deploy:android": "APP_ENV=production USE_CCACHE=0 ANDROID_GOOGLE_SERVICES_FILE=\"$PWD/google-services.json\" EAS_LOCAL_BUILD_ARTIFACTS_DIR=\"$HOME/Desktop/APP_BUILD_ASSET/send\" eas build -p android --profile production-android --local"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/analytics": "^23.8.8",
    "@react-native-firebase/app": "^23.8.8",
    "expo": "^56.0.0",
    "expo-build-properties": "~56.0.14",
    "expo-clipboard": "~56.0.3",
    "expo-constants": "~56.0.15",
    "expo-dev-client": "~56.0.15",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-linking": "~56.0.11",
    "expo-localization": "~56.0.6",
    "expo-router": "~56.2.6",
    "expo-status-bar": "~56.0.4",
    "expo-store-review": "~56.0.3",
    "expo-system-ui": "~56.0.5",
    "expo-tracking-transparency": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "i18next": "^25.7.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-google-mobile-ads": "^16.3.3",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^24.12.4",
    "@types/react": "~19.2.10",
    "typescript": "~6.0.3"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "USE_COMMIT_HOOK_ONLY_FOR_REACT_COMMITS": true
    }
  }
}
