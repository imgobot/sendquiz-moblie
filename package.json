{
  "name": "@send/mobile",
  "version": "1.0.0",
  "engines": {
    "node": "24.14.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm test",
    "dev:install-ca": "bash scripts/install-dev-ca.sh",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "eb:deploy:ios": "APP_ENV=production USE_CCACHE=0 IOS_GOOGLE_SERVICES_FILE=\"$PWD/GoogleService-Info.plist\" EAS_LOCAL_BUILD_ARTIFACTS_DIR=\"$HOME/Desktop/APP_BUILD_ASSET/send\" eas build -p ios --profile production-ios --local",
    "eb:deploy:android": "APP_ENV=production USE_CCACHE=0 ANDROID_GOOGLE_SERVICES_FILE=\"$PWD/google-services.json\" EAS_LOCAL_BUILD_ARTIFACTS_DIR=\"$HOME/Desktop/APP_BUILD_ASSET/send\" eas build -p android --profile production-android --local"
  },
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~58.0.29",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/analytics": "^27.1.1",
    "@react-native-firebase/app": "^27.1.1",
    "expo": "^58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "expo-store-review": "~58.0.3",
    "expo-system-ui": "~58.0.7",
    "expo-tracking-transparency": "~58.1.0",
    "expo-web-browser": "~58.1.0",
    "i18next": "^26.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.13",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^24.12.4",
    "@types/react": "~19.3.0",
    "oxlint": "^1.93.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "USE_COMMIT_HOOK_ONLY_FOR_REACT_COMMITS": true
    }
  }
}
